    "@getlibero/runner": "workspace:*",
    "@getlibero/schema": "workspace:*",
    "@getlibero/server": "workspace:*",
    "@getlibero/memory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "sqlite-vec": "^0.1.9"
  }
