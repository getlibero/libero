{
  "name": "@getlibero/proxy-server",
  "version": "0.0.1",
  "private": true,
  "description": "The tool-proxy process: composes @getlibero/proxy, listens only on localhost/private network with mTLS between services.",
  "license": "MIT",
  "files": ["dist"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "vault": "node dist/vault.js",
    "budget": "node dist/budget.js",
    "audit": "node dist/audit.js",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@getlibero/proxy": "workspace:*",
    "@getlibero/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
