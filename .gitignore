node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example
channels/*/store.db*
channels/*/MEMORY.md
audit.db*
coverage/

# mTLS material from scripts/dev-certs.sh. Private keys — never committed,
# here or in the repo holding your team sheets.
deploy/certs/
*.key
*.pem

# The credential vault. Ciphertext, so committing one would not disclose a
# secret on its own — but it is deployment state, and a repository is exactly
# where a copy of it sits next to the key in someone's .env. The glob covers
# the writer's temporary files.
deploy/vault/
vault.enc*
.vault.enc*
