---
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// `hide` is the width below which a link drops out of the header. Everything
// dropped is still reachable from the footer, which lists all of them.
const links = [
  { href: '/docs', label: 'Docs' },
  { href: '/security', label: 'Security', hide: 'xs' },
  { href: '/why', label: 'Why', hide: 'sm' },
  { href: '/blog', label: 'Blog', hide: 'sm' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Libero, home">
      <Mark size={26} />
      <span class="lb-wordmark lb-wordmark--sm">libero</span>
    </a>

    <nav class="site-header__nav" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['site-header__link', link.hide && `site-header__link--hide-${link.hide}`]}
            aria-current={path === link.href || path.startsWith(link.href + '/') ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://github.com/getlibero/libero"
        class="site-header__link"
        rel="noopener"
      >
        GitHub
      </a>
      {/* Drops at the same width as Security. The docs header carries Discord
          next to GitHub, so this keeps the two headers saying the same thing. */}
      <a
        href={SITE.discord}
        class="site-header__link site-header__link--hide-xs"
        rel="noopener"
      >
        Discord
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
