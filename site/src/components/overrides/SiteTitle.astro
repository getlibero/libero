---
/**
 * The docs header brand. Links to the site root, not to /docs — the docs are
 * a section of getlibero.com, not a separate property.
 */
import Mark from '../Mark.astro';
---

<a href="/" class="lb-site-title">
  <Mark size={26} />
  <span class="lb-site-title__word">libero</span>
  <span class="lb-site-title__section">docs</span>
</a>

<style>
  .lb-site-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--lb-text);
    text-decoration: none;
    overflow: hidden;
    white-space: nowrap;
  }

  .lb-site-title__word {
    font: 600 20px/1 var(--lb-font-sans);
    letter-spacing: -0.02em;
  }

  /* The section label is machine-ish wayfinding, so it takes the mono/label
     treatment rather than reading as a second word in the name. */
  .lb-site-title__section {
    padding-top: 1px;
    font: 500 11px/1 var(--lb-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lb-text-muted);
  }

  @media (max-width: 30rem) {
    .lb-site-title__section {
      display: none;
    }
  }
</style>
