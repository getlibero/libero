---
/**
 * Starlight's Head with two tags added, both of which the marketing layout
 * adds for itself: this page's markdown sibling, and analytics.
 *
 * rel=alternate is an override rather than a `head` entry in astro.config.mjs
 * because that list is static for the whole site and this href is per page.
 * GitHub Pages cannot do content negotiation — the same reason /discord is a
 * meta-refresh rather than a 301 — so this tag and /llms.txt are the entire
 * discovery story for the siblings. Without them a reader has to guess the
 * URL scheme.
 *
 * Analytics is a component rather than a copied script element so the two
 * surfaces cannot drift; its own header has the reasoning.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from '../Analytics.astro';
import { markdownPath } from '../../lib/page-markdown';

const href = markdownPath(`/${Astro.locals.starlightRoute.entry.id}/`);
---

{/* Starlight's Head renders no slot of its own, so these are sibling tags
    rather than a wrapper — passing children would silently drop them. */}
<Default />
<link rel="alternate" type="text/markdown" href={href} />
<Analytics />
