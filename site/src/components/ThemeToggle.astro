---
/**
 * Light/dark toggle. Used on the marketing pages and, via
 * overrides/ThemeSelect.astro, in the docs header — one control, one
 * behaviour, one stored key.
 *
 * Self-contained on purpose: the docs load the tokens without the design
 * system's component layer, so this cannot lean on .lb-btn.
 */
import { THEME_STORAGE_KEY } from '../lib/theme-script';
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-storage-key={THEME_STORAGE_KEY}
  aria-label="Switch between light and dark"
>
  <svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
    ></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
    border: 1px solid transparent;
    border-radius: var(--lb-radius-sm);
    background: transparent;
    color: var(--lb-text-muted);
    cursor: pointer;
    transition: color 0.12s ease, border-color 0.12s ease;
  }

  .theme-toggle:hover {
    color: var(--lb-text);
    border-color: var(--lb-border-strong);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--lb-accent);
    outline-offset: 2px;
  }

  /* 24 grid, 1.6 stroke, round caps and joins, no fills. */
  .theme-toggle__icon {
    display: block;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the mode the button switches *to*. */
  :global(:root[data-theme='light']) .theme-toggle__sun,
  :global(:root:not([data-theme='light'])) .theme-toggle__moon {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem(button.dataset.storageKey!, next);
      } catch {
        // Storage disabled — the toggle still works for this page.
      }
    });
  }
</script>
