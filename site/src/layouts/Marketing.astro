---
/**
 * The frame for every page outside the docs. Starlight owns its own layout;
 * this owns the rest, and both read the same tokens and the same theme key.
 */
import '../styles/fonts.css';
import '../styles/site.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../consts';
import { themeScript } from '../lib/theme-script';
import { markdownPath } from '../lib/page-markdown';

interface Props {
  title: string;
  description?: string;
  /** Set where the title already contains the site name, so it isn't repeated. */
  bareTitle?: boolean;
  /** Blog posts are articles; everything else is a website. */
  ogType?: 'website' | 'article';
  /** Required for og:type="article" — the post's publication date. */
  publishedTime?: Date;
  /**
   * Set on pages that have a markdown sibling, which on this surface is blog
   * posts and nothing else — the marketing pages are .astro rather than
   * collection entries, so there is no body to serve.
   */
  markdown?: boolean;
}

const {
  title,
  description = SITE.description,
  bareTitle = false,
  ogType = 'website',
  publishedTime,
  markdown = false,
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${SITE.name}`;

// Trailing slash, always. GitHub Pages serves /why/ from why/index.html and
// 301s /why to it, so the un-slashed form is a redirect — pointing a canonical
// at a redirect throws away the signal and contradicts the sitemap, which
// @astrojs/sitemap emits with the slash. Starlight already canonicalises this
// way; this is the marketing side agreeing with it.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site ?? SITE.url);
const social = new URL('/og.png', Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdownPath(path)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social} />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Inlined so the theme is settled before first paint. Shared verbatim
        with the docs — see src/lib/theme-script.ts. */}
    <script is:inline set:html={themeScript} />
  </head>

  <body>
    <div class="site">
      <SiteHeader />
      <main class="site__main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
