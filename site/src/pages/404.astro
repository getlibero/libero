---
import Marketing from '../layouts/Marketing.astro';
---

<Marketing title="Not found" description="That page does not exist.">
  <section class="wrap wrap--narrow section" style="padding-top:120px;">
    <span class="lb-label lb-label--dim">404</span>
    <h1 class="page-head__title" style="margin-top:12px;">Not on the allowlist.</h1>
    <p class="page-head__sub">That page does not exist.</p>

    <div class="lb-cluster lb-gap-10 u-mt-40">
      <a class="lb-btn lb-btn--primary" href="/">Home</a>
      <a class="lb-btn lb-btn--secondary" href="/docs">Docs</a>
    </div>
  </section>
</Marketing>
