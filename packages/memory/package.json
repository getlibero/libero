{
  "name": "@getlibero/memory",
  "version": "0.0.1",
  "private": true,
  "description": "Per-channel message store for Libero. One SQLite file per channel with an FTS5 index; the file-per-channel layout is the isolation boundary.",
  "license": "MIT",
  "files": ["dist"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@getlibero/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
