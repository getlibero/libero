{
  "name": "@getlibero/cli",
  "version": "0.7.0",
  "description": "Libero CLI \u2014 the host-authored half of a deployment: init, channel add, doctor.",
  "keywords": [
    "libero",
    "slack",
    "ai-agent",
    "self-hosted",
    "mcp",
    "devops"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "libero": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/dev-certs.sh",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/getlibero/libero.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/getlibero/libero/issues"
  },
  "homepage": "https://getlibero.com",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=@getlibero/test-kit/reporter 'dist/**/*.test.js'"
  },
  "devDependencies": {
    "@getlibero/atomic-write": "workspace:*",
    "@getlibero/schema": "workspace:*",
    "@getlibero/test-kit": "workspace:*",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "expect": "^30.4.1"
  }
}
