{
  "name": "@getlibero/proxy",
  "version": "0.0.1",
  "private": true,
  "description": "Tool proxy for Libero: team-sheet enforcement, credential vault, approvals, budget meter, audit log. Holds every credential; the agent reaches tools only through this service.",
  "license": "MIT",
  "files": ["dist"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@getlibero/schema": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
