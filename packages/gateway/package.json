    "@slack/socket-mode": "^3.0.0",
    "@slack/types": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@getlibero/test-kit": "workspace:*",
    "@types/node": "^24.13.3",
    "expect": "^30.4.1"
  }
}
