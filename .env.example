# Slack (Socket Mode — no inbound ports needed)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Which provider the agent completes against, and which model. Both required.
# The provider is never inferred from which key is set below: both are declared
# here, so inferring it would quietly bill the other account.
AGENT_PROVIDER=anthropic          # anthropic | openai-compatible
AGENT_MODEL=claude-sonnet-4-6

# The team sheets, one directory per channel holding a channel.toml. Both
# services read the same directory and do not read it the same way: for the
# proxy it is the authorization source, and for the agent it is advisory — the
# per-channel model and the four per-task caps the loop applies to itself.
# Both required; docker-compose sets its own paths.
AGENT_CHANNELS_ROOT=channels
PROXY_CHANNELS_ROOT=channels

# The per-channel message stores: one <channel>/store.db under this root,
# written by the agent as ordinary messages arrive. Required, and deliberately
# NOT a subdirectory of the channels root above — that directory is where the
# proxy reads its authorization from and is read-only to both services, so an
# agent able to write there could rewrite a channel.toml and widen what its own
# channel may do. docker-compose sets this itself, to a named volume; it is here
# for running the agent directly. The directory must exist and be writable, for
# SQLite's -wal and -shm.
#
# Unlike the two proxy databases below, this one is not "nothing in it is a
# secret": it holds what people said in a channel, and it belongs to that
# channel's members.
AGENT_STORE_ROOT=deploy/store

# LLM completion keys (agent service ONLY — never tool credentials). Only the
# one matching AGENT_PROVIDER is read; the other is ignored.
ANTHROPIC_API_KEY=
# Optional. Leave unset for Anthropic's own endpoint.
ANTHROPIC_BASE_URL=

# Any OpenAI-compatible endpoint: OpenAI, Together, Fireworks, Baseten, Groq,
# Ollama, Gemini's compatibility endpoint, or a LiteLLM sidecar. Leave the base
# URL unset for OpenAI itself.
#   Groq       https://api.groq.com/openai/v1
#   Together   https://api.together.xyz/v1
#   Fireworks  https://api.fireworks.ai/inference/v1
#   Baseten    https://inference.baseten.co/v1
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama     http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Proxy vault master key — encrypts every tool credential at rest.
# Generate with: openssl rand -base64 32
# Lose it and the vault is unreadable; there is no recovery path and no escrow.
PROXY_VAULT_KEY=
# Where the encrypted vault lives. docker-compose sets this itself, to a named
# volume; it is here for running the proxy directly.
PROXY_VAULT_FILE=deploy/vault/vault.enc
# The daily budget meter, per channel per UTC day. Same story: docker-compose
# sets this itself, to a named volume, and it is here for running the proxy
# directly. The directory must exist and be writable — SQLite puts a -wal and a
# -shm file next to this one. Nothing in it is a secret.
PROXY_BUDGET_DB=deploy/budget/budget.db
# The audit log: one row per decided tool call, append-only. Same story again —
# docker-compose sets this itself and it is here for running the proxy directly,
# and the directory must exist and be writable for the -wal and -shm files.
# Nothing in it is a secret: names, ids, and a hash of the model's arguments,
# never an argument value and never a credential.
PROXY_AUDIT_DB=deploy/audit/audit.db

# Mutual TLS between the two services. These are paths to files, not secrets to
# paste: generate the files with `sh scripts/dev-certs.sh`, which writes them to
# deploy/certs. docker-compose sets these itself and needs nothing here — they
# are for running the proxy directly.
#
# The proxy's own identity, and the CA every client cert is checked against.
PROXY_TLS_CERT=deploy/certs/proxy/server.pem
PROXY_TLS_KEY=deploy/certs/proxy/server.key
PROXY_TLS_CA=deploy/certs/ca.pem
# Where it listens. Localhost by default; widen it deliberately or not at all.
# Left empty or removed, it stays on localhost.
PROXY_HOST=127.0.0.1
PROXY_PORT=8443
