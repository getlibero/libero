# The contract for running the two processes DIRECTLY, on a host, with
# host-relative paths. It is not the file a compose deployment reads.
#
# `libero init` writes that other file, `deploy/.env`, and it is a strict
# subset of this one: the ten variables deploy/docker-compose.yml interpolates
# and no more, because compose sets every path itself and those paths are
# inside a container. Compose loads the .env beside the compose file — with no
# --project-directory the project directory is the compose file's own — so an
# .env copied from this file to the repository root is read by nothing, and one
# copied to deploy/ would set eleven variables that compose overrides anyway.
#
# Copy this one when you are running `node dist/index.js` in two terminals.
# Run `npx @getlibero/cli init` when you are running compose.

# Slack (Socket Mode — no inbound ports needed). Both tokens come out of the app
# created from deploy/slack-app-manifest.yml: the app-level one when you generate
# it with the connections:write scope, the bot one when you install to the
# workspace.
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Which provider the agent completes against, and which model. Both required.
# The provider is never inferred from which key is set below: both are declared
# here, so inferring it would quietly bill the other account.
AGENT_PROVIDER=anthropic          # anthropic | openai-compatible
AGENT_MODEL=claude-sonnet-4-6

# The team sheets, one directory per channel holding a channel.toml. Both
# services read the same directory and do not read it the same way: for the
# proxy it is the authorization source, and for the agent it is advisory — the
# per-channel model and the four per-task caps the loop applies to itself.
# Both required; docker-compose sets its own paths.
AGENT_CHANNELS_ROOT=channels
PROXY_CHANNELS_ROOT=channels

# The per-channel message stores: one <channel>/store.db under this root,
# written by the agent as ordinary messages arrive. Required, and deliberately
# NOT a subdirectory of the channels root above — that directory is where the
# proxy reads its authorization from and is read-only to both services, so an
# agent able to write there could rewrite a channel.toml and widen what its own
# channel may do. docker-compose sets this itself, to a named volume; it is here
# for running the agent directly. The directory must exist and be writable, for
# SQLite's -wal and -shm.
#
# Unlike the two proxy databases below, this one is not "nothing in it is a
# secret": it holds what people said in a channel, and it belongs to that
# channel's members.
AGENT_STORE_ROOT=deploy/store

# How the agent reaches the tool proxy. Both required, and docker-compose sets
# them itself; they are here for running the agent directly. The third piece is
# PROXY_TLS_CA further down, which the agent reads too — it is what verifies the
# proxy's own certificate, and it is one variable rather than two because both
# services check against the same anchor.
#
# PROXY_URL must be https, and that is checked at startup rather than at the
# first call: the client certificate is the only thing that says which channel is
# calling, so a plaintext transport would be an unauthenticated one. Use the host
# and port PROXY_HOST and PROXY_PORT name below — the certificate dev-certs.sh
# mints covers `proxy` (the compose service), `localhost`, and the loopback
# addresses, and nothing else.
PROXY_URL=https://localhost:8443
# One client-<CHANNEL_ID>.pem per channel, and this directory is the agent's
# entire authority: no certificate, no call. It holds no CA key, because a
# process that can mint certificates can name itself any channel.
PROXY_CLIENT_CERT_DIR=deploy/certs/agent

# LLM completion keys (agent service ONLY — never tool credentials). Only the
# one matching AGENT_PROVIDER is read; the other is ignored.
ANTHROPIC_API_KEY=
# Optional. Leave unset for Anthropic's own endpoint.
ANTHROPIC_BASE_URL=

# Any OpenAI-compatible endpoint: OpenAI, Together, Fireworks, Baseten, Groq,
# Ollama, Gemini's compatibility endpoint, or a LiteLLM sidecar. Leave the base
# URL unset for OpenAI itself.
#   Groq       https://api.groq.com/openai/v1
#   Together   https://api.together.xyz/v1
#   Fireworks  https://api.fireworks.ai/inference/v1
#   Baseten    https://inference.baseten.co/v1
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama     http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Proxy vault master key — encrypts every tool credential at rest.
# Generate with: openssl rand -base64 32
# Lose it and the vault is unreadable; there is no recovery path and no escrow.
PROXY_VAULT_KEY=
# Where the encrypted vault lives. docker-compose sets this itself, to a named
# volume; it is here for running the proxy directly.
PROXY_VAULT_FILE=deploy/vault/vault.enc
# The daily budget meter, per channel per UTC day. Same story: docker-compose
# sets this itself, to a named volume, and it is here for running the proxy
# directly. The directory must exist and be writable — SQLite puts a -wal and a
# -shm file next to this one. Nothing in it is a secret.
PROXY_BUDGET_DB=deploy/budget/budget.db
# The audit log: one row per decided tool call, append-only. Same story again —
# docker-compose sets this itself and it is here for running the proxy directly,
# and the directory must exist and be writable for the -wal and -shm files.
# Nothing in it is a secret: names, ids, and a hash of the model's arguments,
# never an argument value and never a credential.
PROXY_AUDIT_DB=deploy/audit/audit.db

# The same directory as AGENT_STORE_ROOT above, read by the proxy to answer
# search_channel_history (#64). Two names for one path because the two services
# are configured separately; point them at the same place or the tool finds an
# empty channel. Every file is opened read-only, but the directory still has to
# be writable, because a SQLite WAL reader creates the -shm and -wal sidecars.
#
# It is NOT PROXY_CHANNELS_ROOT. Team sheets are where the proxy reads its
# authorization from and the agent must not be able to write there, so the store
# has its own root on the agent's writable side.
PROXY_STORE_ROOT=deploy/store

# Mutual TLS between the two services. These are paths to files, not secrets to
# paste: generate the files with `sh scripts/dev-certs.sh`, which writes them to
# deploy/certs. docker-compose sets these itself and needs nothing here — they
# are for running the proxy directly.
#
# The proxy's own identity, and the CA every client cert is checked against.
PROXY_TLS_CERT=deploy/certs/proxy/server.pem
PROXY_TLS_KEY=deploy/certs/proxy/server.key
PROXY_TLS_CA=deploy/certs/ca.pem
# Where it listens. Localhost by default; widen it deliberately or not at all.
# Left empty or removed, it stays on localhost.
PROXY_HOST=127.0.0.1
PROXY_PORT=8443
# How much of an upstream's answer the proxy will hold before abandoning it.
# Past this the read is cancelled undecoded and the call fails; nothing of the
# body reaches the model or the log. Four megabytes is above any real tools/list
# catalog and any ordinary tool answer.
#
# Not a team sheet field, deliberately: this buys memory in a process every
# channel shares, so no channel may raise it. The companion bound — how much of
# a result reaches the model — *is* a sheet field ([llm] max_result_chars),
# because that one spends the channel's own token budget.
#
# Raising it costs three to five times its value per concurrent call: the
# decoded string, the redaction pass's copy, and the parsed object all at once.
PROXY_MAX_RESPONSE_BYTES=4194304
# How many calls this proxy will run against one tool server at once. Past this
# a call waits a few seconds for one ahead of it to finish, and is then answered
# "the call was not made" rather than queued indefinitely.
#
# It is what makes the bound above add up to a number: what one misbehaving
# upstream can cost this process is that value, times its three-to-five-fold
# decoding overhead, times this. Without it the last factor is unbounded.
#
# It also stops one busy channel from spending a shared upstream's rate limit on
# every other channel's behalf. "One upstream" is one url and one credential, so
# two channels naming the same server share this budget — which is right, since
# they are already the same identity as far as that server is concerned.
#
# Eight is a guess about tool servers, not about this process. Set it to what
# yours actually tolerates; one is a legitimate answer.
PROXY_MAX_UPSTREAM_CONCURRENCY=8
